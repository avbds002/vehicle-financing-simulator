PORT=3333
NODE_ENV=development

# -----------------------------------------------
# Database — PostgreSQL (Supabase or local PG)
# -----------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vehicle_financing?schema=public"

# Alternative: SQLite (local dev, no external DB needed)
# DATABASE_URL="file:./dev.db"

# -----------------------------------------------
# Authentication — JWT
# -----------------------------------------------
JWT_SECRET="sua_chave_secreta_super_segura_jwt_troque_em_producao"
JWT_EXPIRES_IN="24h"
